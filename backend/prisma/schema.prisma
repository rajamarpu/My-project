generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonType {
  VIDEO
  QUIZ
  ARTICLE
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

enum UserRole {
  USER
  INSTRUCTOR
  ADMIN
}

enum AccountStatus {
  APPROVED
  PENDING
  REJECTED
  SUSPENDED
}

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTIPLE
  FILL_BLANK
  DESCRIPTIVE
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

model User {
  id             Int             @id @default(autoincrement())
  name           String          @map("full_name")
  email          String          @unique
  phone          String?
  passwordHash   String          @map("password_hash")
  role           UserRole        @default(USER)
  approvalStatus AccountStatus   @default(APPROVED)
  avatarUrl      String?         @map("avatar_url")
  bio            String?
  expertise      String?
  socialLinks    Json?
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  enrollments    Enrollment[]
  selectedInstructorEnrollments Enrollment[] @relation("EnrollmentInstructor")
  instructorSwitches            InstructorChangeHistory[] @relation("InstructorChangeLearner")
  instructorChangesFrom         InstructorChangeHistory[] @relation("InstructorChangeFrom")
  instructorChangesTo           InstructorChangeHistory[] @relation("InstructorChangeTo")
  instructorChangesBy           InstructorChangeHistory[] @relation("InstructorChangeChangedBy")
  progress       Progress[]
  chatMessages   ChatMessage[]
  notifications  Notification[]
  certificates   Certificate[]
  analytics      AnalyticsEvent[]
  moderatedChats ChatMessage[]    @relation("ModeratorActions")
  coursesCreated Course[]         @relation("CourseCreator")
  questionsCreated Question[]     @relation("QuestionCreator")
  payments       Payment[]
  sessions       Session[]
  activityLogs   ActivityLog[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]

  @@index([isActive])
  @@map("categories")
}

model Course {
  id              String          @id @default(cuid())
  title           String
  slug            String          @unique
  description     String
  category        String
  categoryId      String?
  level           CourseLevel     @default(BEGINNER)
  priceCents      Int             @default(0)
  thumbnailUrl    String?
  videoPreviewUrl String?
  isPublished     Boolean         @default(false)
  createdById     Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  categoryRef     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy       User?           @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lessons         Lesson[]
  enrollments     Enrollment[]
  progress        Progress[]
  chatMessages    ChatMessage[]
  certificates    Certificate[]
  analytics       AnalyticsEvent[]
  payments        Payment[]
  instructorChanges InstructorChangeHistory[]
  questions       Question[]

  @@index([category])
  @@index([categoryId])
  @@index([isPublished])
  @@index([createdAt])
  @@map("courses")
}

model Question {
  id             String          @id @default(cuid())
  type           QuestionType
  text           String
  options        Json?
  correctAnswers Json?
  marks          Int             @default(1)
  difficulty     DifficultyLevel @default(MEDIUM)
  courseId       String?
  explanation    String?
  caseSensitive  Boolean         @default(false)
  createdById    Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  course         Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("QuestionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([difficulty])
  @@index([courseId])
  @@index([createdAt])
  @@map("questions")
}

model Lesson {
  id           String       @id @default(cuid())
  courseId     String
  title        String
  description  String?
  type         LessonType   @default(VIDEO)
  videoUrl     String?
  durationMin  Int          @default(0)
  sortOrder    Int          @default(0)
  quizJson     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress     Progress[]

  @@index([courseId, sortOrder])
  @@map("lessons")
}

model AIPersonality {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  archetype      String
  avatarUrl      String?
  voiceStyle     String
  teachingStyle  String
  traits         String[]
  promptTemplate String
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  enrollments    Enrollment[]
  analytics      AnalyticsEvent[]

  @@index([isActive])
  @@map("ai_personalities")
}

model Enrollment {
  id              String         @id @default(cuid())
  userId          Int
  courseId        String
  personalityId   String?
  currentInstructorId Int?
  completionPct   Int            @default(0)
  hoursStudied    Float          @default(0)
  quizAverage     Int            @default(0)
  streakDays      Int            @default(0)
  enrolledAt      DateTime       @default(now())
  completedAt     DateTime?
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  personality     AIPersonality? @relation(fields: [personalityId], references: [id], onDelete: SetNull)
  currentInstructor User?        @relation("EnrollmentInstructor", fields: [currentInstructorId], references: [id], onDelete: SetNull)
  instructorChanges InstructorChangeHistory[]

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([personalityId])
  @@index([currentInstructorId])
  @@map("enrollments")
}

model InstructorChangeHistory {
  id                   String     @id @default(cuid())
  enrollmentId          String
  userId                Int
  courseId              String
  fromInstructorId      Int?
  toInstructorId        Int
  changedById           Int?
  reason                String?
  createdAt             DateTime   @default(now())
  enrollment            Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  learner               User       @relation("InstructorChangeLearner", fields: [userId], references: [id], onDelete: Cascade)
  course                Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  fromInstructor        User?      @relation("InstructorChangeFrom", fields: [fromInstructorId], references: [id], onDelete: SetNull)
  toInstructor          User       @relation("InstructorChangeTo", fields: [toInstructorId], references: [id], onDelete: Cascade)
  changedBy             User?      @relation("InstructorChangeChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([enrollmentId, createdAt])
  @@index([courseId, createdAt])
  @@index([userId, createdAt])
  @@index([toInstructorId])
  @@map("instructor_change_history")
}

model Progress {
  id              String    @id @default(cuid())
  userId          Int
  courseId        String
  lessonId        String?
  percentComplete Int       @default(0)
  completed       Boolean   @default(false)
  watchedSeconds  Int       @default(0)
  quizScore       Int?
  lastAccessedAt  DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson          Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId, lessonId])
  @@index([userId, lastAccessedAt])
  @@index([courseId])
  @@map("progress")
}

model ChatMessage {
  id            String        @id @default(cuid())
  roomId        String
  courseId      String?
  senderId      Int
  parentId      String?
  body          String
  emoji         String?
  isDeleted     Boolean       @default(false)
  moderatedById Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  course        Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sender        User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  parent        ChatMessage?  @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies       ChatMessage[] @relation("MessageReplies")
  moderatedBy   User?         @relation("ModeratorActions", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
  @@index([courseId])
  @@index([senderId])
  @@map("chat_messages")
}

model Notification {
  id        String   @id @default(cuid())
  userId    Int
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Payment {
  id              String    @id @default(cuid())
  userId          Int
  courseId        String?
  amountCents     Int
  currency        String    @default("INR")
  provider        String?
  providerRef     String?
  status          String    @default("PENDING")
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([courseId])
  @@index([status])
  @@map("payments")
}

model Session {
  id           String    @id @default(cuid())
  userId       Int
  tokenHash    String    @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     Int?
  action     String
  entityType String?
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("activity_logs")
}

model AnalyticsEvent {
  id            String         @id @default(cuid())
  userId        Int?
  courseId      String?
  personalityId String?
  eventType     String
  value         Float?
  metadata      Json?
  createdAt     DateTime       @default(now())
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  course        Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  personality   AIPersonality? @relation(fields: [personalityId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@index([courseId, createdAt])
  @@map("analytics_events")
}

model Certificate {
  id             String            @id @default(cuid())
  userId         Int
  courseId       String
  certificateNo  String            @unique
  status         CertificateStatus @default(ISSUED)
  issuedAt       DateTime          @default(now())
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([issuedAt])
  @@map("certificates")
}
